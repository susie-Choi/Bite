# Google Analytics 4 Measurement ID
# GA4에서 발급받은 측정 ID를 입력하세요.
# 없어도 앱은 정상 동작하며, analytics 이벤트만 전송되지 않습니다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps API Key
# Google Cloud Console에서 Maps JavaScript API를 활성화한 뒤 발급받은 키를 입력하세요.
# 없으면 지도 대신 안내 메시지가 표시됩니다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
